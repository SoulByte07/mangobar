#define _GNU_SOURCE
#include "tray.h"
#include "sd-bus.h"

#include <arpa/inet.h>
#include <dirent.h>
#include <errno.h>
#include <gdk-pixbuf/gdk-pixbuf.h>
#include <limits.h>
#include <poll.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <unistd.h>
#include <wayland-util.h>

#define WATCHER_PATH "/StatusNotifierWatcher"
#define DEFAULT_ICON_SIZE 64

typedef struct {
  int size;
  uint32_t pixels[]; // host-order ARGB (unpremultiplied)
